# ==========================================
# KONFIGURASI DATABASE (Turso libSQL Cloud)
# ==========================================
# Untuk cloud SQLite Turso (Vercel deployment):
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-jwt-token

# ==========================================
# KEAMANAN APLIKASI & ENKRIPSI
# ==========================================
# Password login untuk membuka web jurnal
JOURNAL_PASSWORD=

# Kunci enkripsi AES-256 untuk kredensial broker & data sensitif
JOURNAL_SECRET=

# Secret key untuk webhook MT4 / MT5 EA (InpApiKey)
MT_WEBHOOK_SECRET=

# ==========================================
# AI INTEGRATION (Opsional)
# ==========================================
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
